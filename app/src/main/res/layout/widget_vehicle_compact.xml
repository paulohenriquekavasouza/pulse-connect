<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:baselineAligned="false"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:id="@+id/widget_header"
        android:layout_width="68dp"
        android:layout_height="44dp"
        android:layout_marginEnd="6dp">

        <ImageView
            android:id="@+id/widget_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/vehicle_image"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_car_widget" />

        <ProgressBar
            android:id="@+id/widget_progress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/text_primary"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widget_lock"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_bg"
            android:contentDescription="@string/action_lock">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/action_icon_bg"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_lock"
                android:tint="@color/text_primary" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_unlock"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_bg"
            android:contentDescription="@string/action_unlock">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/action_icon_bg"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_lock_open"
                android:tint="@color/text_primary" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_start"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_bg"
            android:contentDescription="@string/action_start">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/action_icon_accent_bg"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_power"
                android:tint="@color/accent" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_stop"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_bg"
            android:contentDescription="@string/action_stop">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/action_icon_bg"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_power_off"
                android:tint="@color/text_primary" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
